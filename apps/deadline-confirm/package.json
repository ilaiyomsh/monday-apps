{
  "name": "deadline-confirm",
  "version": "0.10.0",
  "description": "One-click deadline confirmation from email — status transition + attribution update (monday code)",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.0.0"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "dev:server": "nodemon ./src/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build": "npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@axiomhq/js": "^1.3.1",
    "@mondaycom/apps-sdk": "^0.1.4",
    "@vibe/core": "^3.82.2",
    "@vibe/icons": "^1.14.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "monday-sdk-js": "^0.5.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^3.0.0"
  }
}
