{
  "name": "sync-calender",
  "version": "2.2.0",
  "description": "One-way sync from Google Calendar to monday.com board",
  "type": "module",
  "engines": {
    "node": "^20.0.0"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "dev:server": "nodemon ./src/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build": "npm run build:client",
    "typecheck": "tsc --noEmit",
    "lint": "echo no-lint-configured",
    "type-check": "echo no-typescript"
  },
  "dependencies": {
    "@axiomhq/js": "^1.3.1",
    "@lexical/react": "^0.43.0",
    "@lexical/utils": "^0.43.0",
    "@mondaycom/apps-sdk": "^0.1.4",
    "@vibe/core": "^3.82.2",
    "@vibe/icons": "^1.14.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "googleapis": "^130.0.0",
    "jsonwebtoken": "^9.0.0",
    "lexical": "^0.43.0",
    "monday-sdk-js": "^0.5.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@mondaycom/apps-cli": "^4.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.0"
  }
}
