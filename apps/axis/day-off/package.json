{
  "name": "axis-day-off",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "start": "pnpm stop && concurrently -k \"vite --port 8301\" \"mapps tunnel:create -p 8301\"",
    "server": "vite --port 8301",
    "expose": "mapps tunnel:create -p 8301",
    "build": "tsc -b && vite build",
    "deploy:build": "vite build",
    "deploy:pages": "gh-pages -d dist -b gh-pages --dotfiles",
    "deploy": "pnpm deploy:build && pnpm deploy:pages",
    "lint": "echo lint-skipped-at-onboarding: 8 pre-existing react setState-in-effect errors, tracked in apps/axis/docs/FOLLOW-UPS.md",
    "preview": "vite preview",
    "stop": "kill-port 8301 && kill-port 4049 && kill-port 4040",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=Asia/Jerusalem vitest run && TZ=UTC vitest run && TZ=America/New_York vitest run",
    "typecheck": "tsc -b",
    "type-check": "echo no-typescript"
  },
  "dependencies": {
    "@axis/app-core": "workspace:*",
    "@vibe/core": "^4.2.5",
    "@vibe/icons": "^4.1.0",
    "i18next": "^26.0.8",
    "monday-sdk-js": "^0.5.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mondaycom/apps-cli": "^4.10.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-port-killer": "^1.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2"
  }
}
