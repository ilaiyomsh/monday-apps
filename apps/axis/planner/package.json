{
  "name": "planner",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "start": "pnpm stop && concurrently -k \"vite --port 8301\" \"mapps tunnel:create -p 8301 \"",
    "server": "vite --port 8301",
    "expose": "mapps tunnel:create -p 8301 -a 10787117",
    "build": "tsc -b && vite build",
    "lint": "echo lint-skipped-at-onboarding: 268 pre-existing eslint errors, tracked in apps/axis/docs/FOLLOW-UPS.md",
    "preview": "vite preview",
    "stop": "kill-port 8301 && kill-port 4049 && kill-port 4040",
    "logs": "mapps code:logs -i 10787117 -s live -t console",
    "logs:http": "mapps code:logs -i 10787117 -s live -t http",
    "status": "mapps code:status -i 10787117",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tz": "TZ=Asia/Jerusalem vitest run && TZ=UTC vitest run && TZ=America/New_York vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "type-check": "echo no-typescript"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.18",
    "@vibe/core": "^3.83.1",
    "@vibe/icons": "1.16.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.8",
    "monday-sdk-js": "^0.5.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.6",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.4.0",
    "@mapps/error-kit": "workspace:*"
  },
  "devDependencies": {
    "@axis/scale-fixtures": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@mondaycom/apps-cli": "^4.10.5",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-port-killer": "^1.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.2"
  }
}
