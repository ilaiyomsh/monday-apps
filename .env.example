# Shared environment template for the apps in this monorepo.
# Copy the variables an app needs into that app's own .env (never committed).
# sync-calender is the exception: its server env lives on the monday platform
# via `mapps code:env -i 11666315`, not in a file.

# --- monday.com platform ---
# App signing secret: Developer Center -> your app -> Basic Information
MONDAY_SIGNING_SECRET=<from_developer_center>
# OAuth client credentials: Developer Center -> OAuth & Permissions
MONDAY_CLIENT_ID=<from_developer_center>
MONDAY_CLIENT_SECRET=<from_developer_center>
# Public monday-code origin, without a trailing slash
BASE_URL=https://<deployment-host>
# Optional while activating a non-live app version during OAuth testing
MONDAY_APP_VERSION_ID=<draft_version_id>

# Personal API token is NOT duplicated here — it lives in ~/.config/mapps/.mappsrc
# (written once by `mapps init -t`) and is read by mapps and by
# .claude/skills/mapps/mapps-api.sh. Never put it in a .env or in the repo.

# --- Agent test workspace (sandbox) ---
# "AGENT-TEST — Claude sandbox" (kind: closed) in account yomsheni-il.
# The ONLY workspace agents may write to during API probes and tests.
# Scratch boards there use the WZ- prefix and may be wiped at any time.
# Probe/test scripts must hard-fail if this is unset — never fall back to real boards.
TEST_WORKSPACE_ID=16291824

# --- Local dev servers ---
PORT=8080
NODE_ENV=development
# Local server-only development; production must use monday SecureStorage.
USE_MEMORY_STORAGE=false
