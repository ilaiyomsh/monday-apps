import React, { useState, useEffect } from 'react';
import { Button, TextField } from '@vibe/core';
import mondayService from '../../services/mondayService';
import logger from '../../utils/logger';
import LoadingState from '../shared/LoadingState';
import ErrorState from '../shared/ErrorState';

function WidgetSettings({ context }) {
  const [settings, setSettings] = useState({});
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState(null);

  useEffect(() => {
    loadSettings();
  }, []);

  const loadSettings = async () => {
    try {
      setLoading(true);
      setError(null);

      const storedSettings = await mondayService.getInstanceStorage('widgetSettings');
      setSettings(storedSettings || {});
    } catch (err) {
      // Record the error (never swallow), then surface it to the user via ErrorState.
      logger.error('WidgetSettings', 'Failed to load settings', err);
      setError(err.message || 'Failed to load settings');
    } finally {
      setLoading(false);
    }
  };

  const handleSave = async () => {
    try {
      setSaving(true);
      setError(null);

      await mondayService.setInstanceStorage('widgetSettings', settings);
      mondayService.showNotice('Settings saved successfully');
      mondayService.closeDialog();
    } catch (err) {
      // Record the error (never swallow), then surface it to the user via ErrorState.
      logger.error('WidgetSettings', 'Failed to save settings', err);
      setError(err.message || 'Failed to save settings');
    } finally {
      setSaving(false);
    }
  };

  const handleCancel = () => {
    mondayService.closeDialog();
  };

  const updateSetting = (key, value) => {
    setSettings((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  if (loading) {
    return <LoadingState message="Loading settings..." />;
  }

  if (error) {
    return <ErrorState message={error} onRetry={loadSettings} />;
  }

  return (
    <div className="widget-settings p-4">
      <div className="mb-6">
        <h2 className="text-xl font-semibold mb-1">Widget Settings</h2>
        <p className="text-sm text-gray-500">
          Configure your dashboard widget.
        </p>
      </div>

      <div className="space-y-4 mb-6">
        <div>
          <label className="block text-sm font-medium mb-1">Widget Title</label>
          <TextField
            placeholder="Enter widget title..."
            value={settings.title || ''}
            onChange={(value) => updateSetting('title', value)}
          />
        </div>

        <div>
          <label className="block text-sm font-medium mb-1">Refresh Interval (seconds)</label>
          <TextField
            type="number"
            placeholder="60"
            value={settings.refreshInterval || ''}
            onChange={(value) => updateSetting('refreshInterval', value)}
          />
        </div>
      </div>

      <div className="flex justify-end gap-2">
        <Button kind="secondary" onClick={handleCancel} disabled={saving}>
          Cancel
        </Button>
        <Button onClick={handleSave} loading={saving}>
          Save Settings
        </Button>
      </div>
    </div>
  );
}

export default WidgetSettings;
