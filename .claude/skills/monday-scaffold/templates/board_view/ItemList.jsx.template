import React from 'react';

function ItemList({ items, onItemClick }) {
  if (!items || items.length === 0) {
    return (
      <div className="text-center py-12 text-gray-500">
        No items found in this board.
      </div>
    );
  }

  return (
    <div className="space-y-2">
      {items.map((item) => (
        <div
          key={item.id}
          onClick={() => onItemClick(item.id)}
          className="p-4 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm cursor-pointer transition-all"
        >
          <div className="flex items-center justify-between">
            <div>
              <h3 className="font-medium">{item.name}</h3>
              {item.group && (
                <p className="text-sm text-gray-500">{item.group.title}</p>
              )}
            </div>
            <div className="flex gap-2">
              {item.column_values?.slice(0, 3).map((cv) => (
                cv.text && (
                  <span
                    key={cv.id}
                    className="px-2 py-1 text-xs bg-gray-100 rounded"
                  >
                    {cv.text}
                  </span>
                )
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  );
}

export default ItemList;
