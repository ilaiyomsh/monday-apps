{
  "_doc": "Planner settings template. Same placeholder rules as the Tracker template. Note the 4 adversarial-review blockers baked in correct: (1) roleColumnId is a TEXT column; (2) absenceTypeColumnId points at the Time Logs primary status and absenceTypeAbsentValues are LABEL IDS (the 'daily' label), not text; (3) absenceClassificationColumnId points at the Time Logs dayType status; (4) every status filter value is a real label id read back from the API. Wrapped as { settings: {...} }.",
  "settings": {
    "allocationsBoardId": "{{allocations.id}}",
    "startDateColumnId": "{{allocations.startDate}}",
    "endDateColumnId": "{{allocations.endDate}}",
    "hoursPerDayColumnId": "{{allocations.hoursPerDay}}",
    "totalHoursColumnId": "{{allocations.totalHours}}",
    "projectColumnId": "{{allocations.project}}",
    "employeeColumnId": "{{allocations.employee}}",
    "roleColumnId": "{{allocations.role}}",
    "ftePercentageColumnId": "{{allocations.fte}}",
    "allocationCostColumnId": "{{allocations.cost}}",
    "reportedHoursColumnId": "__IF_TIMELOGS__{{allocations.reportedHours}}__ELSE__null",
    "employeesBoardId": "{{employees.id}}",
    "employeeNameColumnId": "{{employees.name}}",
    "employeeRoleColumnId": "{{employees.orgRole}}",
    "employeeAllocationPercentColumnId": "{{employees.employmentPct}}",
    "employeeCostColumnId": "{{employees.cost}}",
    "employeeUserIdColumnId": "{{employees.linkedUser}}",
    "capabilitiesColumnId": "{{employees.capabilities}}",
    "projectsBoardId": "{{portfolio.id}}",
    "projectNameColumnId": "{{portfolio.name}}",
    "projectManagerColumnId": "{{portfolio.owner}}",
    "filterActiveProjects": false,
    "projectStatusColumnId": "{{portfolio.step}}",
    "activeProjectStatusValues": ["{{portfolio.step:in_progress}}", "{{portfolio.step:future}}"],
    "filterInactiveEmployees": false,
    "employeeStatusColumnId": "{{employees.status}}",
    "activeEmployeeStatusValues": ["{{employees.status:active}}"],
    "enableProjectClassification": false,
    "projectClassificationColumnId": "",
    "internalProjectStatusValues": [],
    "externalProjectStatusValues": [],
    "projectTypeColumnId": "{{portfolio.rag}}",
    "workDayStart": "09:00",
    "workDayEnd": "18:00",
    "effortDisplayMode": "hours_day",
    "maxHoursPerDay": 8.5,
    "maxHoursPerWeek": 42.5,
    "maxHoursPerMonth": 182,
    "workDays": [0, 1, 2, 3, 4],
    "absenceReportBoardId": "__IF_TIMELOGS__{{timeLogs.id}}__ELSE__null",
    "absenceEmployeeColumnId": "__IF_TIMELOGS__{{timeLogs.reporter}}__ELSE__null",
    "absenceDateColumnId": "__IF_TIMELOGS__{{timeLogs.date}}__ELSE__null",
    "absenceTypeColumnId": "__IF_TIMELOGS__{{timeLogs.eventType}}__ELSE__null",
    "absenceTypeAbsentValues": ["{{timeLogs.eventType:daily}}"],
    "absenceClassificationColumnId": "__IF_TIMELOGS__{{timeLogs.dayType}}__ELSE__null",
    "clientColumnId": "__IF_CUSTOMERS__{{portfolio.client}}__ELSE__null",
    "allocationClientColumnId": "__IF_CUSTOMERS__{{allocations.client}}__ELSE__null",
    "languageOverride": "he"
  }
}
