{
  "_doc": "Tracker settings template. provision.py substitutes placeholders from state.json: {{board.id}} = a board's monday id; {{board.colKey}} = a resolved column id; {{board.colKey:labelKey}} = a resolved status label id. Keys whose value is `null`/`__FLAVOR__` are filled from the structure's tracker_flavor or dropped per options. Wrapped as { settings: {...} } for file import. JSON import MERGES into existing app settings — so every key that must change is present explicitly (a stale value survives otherwise).",
  "settings": {
    "structureMode": "__FLAVOR__structureMode",
    "enableNotes": true,
    "showHolidays": true,
    "fieldConfig": {
      "task": "hidden",
      "stage": "required",
      "notes": "optional",
      "billableToggle": "hidden",
      "nonBillableType": "__IF_ROUTINE__optional__ELSE__hidden"
    },
    "projectsSourceMode": "__FLAVOR__projectsSourceMode",
    "connectedBoardId": "{{portfolio.id}}",
    "peopleColumnIds": [],
    "projectTypeColumnId": null,
    "enableProjectTypeDistinction": false,
    "projectTypeMapping": null,
    "projectTypeSourceBoardId": null,
    "projectTypeSourceColumnId": null,
    "projectStatusFilterEnabled": true,
    "projectStatusColumnId": "{{portfolio.step}}",
    "projectActiveStatusValues": ["{{portfolio.step:in_progress}}", "{{portfolio.step:future}}"],
    "tasksBoardId": "",
    "tasksProjectColumnId": "",
    "taskStatusFilterEnabled": false,
    "taskStatusColumnId": null,
    "taskActiveStatusValues": [],
    "useAssignmentsMode": "__FLAVOR__useAssignmentsMode",
    "assignmentsBoardId": "{{allocations.id}}",
    "assignmentPersonColumnId": "{{allocations.employee}}",
    "assignmentStartDateColumnId": "{{allocations.startDate}}",
    "assignmentEndDateColumnId": "{{allocations.endDate}}",
    "assignmentProjectLinkColumnId": "{{allocations.project}}",
    "useCurrentBoardForReporting": "__FLAVOR__useCurrentBoardForReporting",
    "timeReportingBoardId": "{{timeLogs.id}}",
    "dateColumnId": "{{timeLogs.date}}",
    "endTimeColumnId": "{{timeLogs.endTime}}",
    "durationColumnId": "{{timeLogs.duration}}",
    "projectColumnId": "{{timeLogs.project}}",
    "taskColumnId": null,
    "assignmentColumnId": "{{timeLogs.assignment}}",
    "reporterColumnId": "{{timeLogs.reporter}}",
    "eventTypeStatusColumnId": "{{timeLogs.eventType}}",
    "allDayTypeStatusColumnId": "{{timeLogs.dayType}}",
    "nonBillableStatusColumnId": "__IF_ROUTINE__{{timeLogs.routineType}}__ELSE__null",
    "stageColumnId": "{{timeLogs.stage}}",
    "notesColumnId": "{{timeLogs.notes}}",
    "customerColumnId": "__IF_CUSTOMERS__{{portfolio.client}}__ELSE__null",
    "customerReportColumnId": "__IF_CUSTOMERS__{{timeLogs.customer}}__ELSE__null",
    "temporaryCheckboxColumnId": "{{timeLogs.temporary}}",
    "showTemporaryEvents": true,
    "eventTypeMapping": { "{{timeLogs.eventType:daily}}": "allDay", "{{timeLogs.eventType:project}}": "billable" },
    "eventTypeLabelMeta": null,
    "enableApproval": false,
    "approvalStatusColumnId": null,
    "approvalStatusMapping": null,
    "approvalStatusLabelMeta": null,
    "approvedManagerIds": [],
    "filterEmployeesBoardId": "__IF_EMPLOYEES__{{employees.id}}__ELSE__null",
    "filterEmployeesColumnId": "__IF_EMPLOYEES__{{employees.linkedUser}}__ELSE__null",
    "advancedValidation": { "enabled": false, "xorFields": [null, null] },
    "editLockMode": "days_after",
    "editLockDays": 3,
    "lockAfterApproval": false,
    "monthlyHoursTarget": 182.5,
    "weeklyHoursTarget": null,
    "workdayLength": 8.5,
    "workDays": [0, 1, 2, 3, 4],
    "weekStartDay": 0,
    "languageOverride": "he",
    "themeMode": "light"
  }
}
