{
  "name": "@mapps/error-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical error-to-Axiom shipping layer for monday-apps: hardened browser transport + logger sink, React ErrorBoundary, and the reference server sink. Compiled to dist/ (ESM JS + .d.ts) so both CRA (react-scripts) and Vite consumers can import it.",
  "type": "module",
  "exports": {
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@axiomhq/js": "^1.3.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "react": "^19.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
